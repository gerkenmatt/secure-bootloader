# .gitignore

# C/C++ build artifacts from Makefiles
# This covers all *.o, *.elf, *.map, *.bin files generated by the C projects.
**/build/

# Python artifacts
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.so

# Python virtual environment
.venv/
venv/
env/

# Editor/IDE specific files
.vscode/
.idea/
*.suo
*.user
*.sln
*.swp

# OS generated files
.DS_Store
Thumbs.db
._*

# Log files
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*