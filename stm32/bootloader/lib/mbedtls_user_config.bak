#ifndef MBEDTLS_USER_CONFIG_H
#define MBEDTLS_USER_CONFIG_H

/*============================================================================*/
/*        1) Undefine EVERY module you don’t need — eliminate pull-in of       */
/*           DRBGs, key-exchange, X.509, TLS, etc.                            */
/*============================================================================*/

/*============================================================================*/
/*   First, completely remove the platform abstraction layer so that we     */
/*   don’t pull in exit(), printf(), etc. – this lets CMake successfully     */
/*   build a true ARM‐ABI library.                                           */
/*============================================================================*/
#undef MBEDTLS_PLATFORM_C

/* — DRBGs (we don’t sign or reseed) — */
#undef MBEDTLS_CTR_DRBG_C
#undef MBEDTLS_HMAC_DRBG_C

/* — All MBEDTLS_KEY_EXCHANGE_… (TLS kex) — */
#undef MBEDTLS_KEY_EXCHANGE_PSK_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_DHE_PSK_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_ECDHE_PSK_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_DHE_RSA_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_ECDHE_RSA_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_ECDHE_ECDSA_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_ECDH_RSA_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_ECDH_ECDSA_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_RSA_PSK_ENABLED
#undef MBEDTLS_KEY_EXCHANGE_RSA_ENABLED

/* — Signature-generation flags you don’t need — */
#undef MBEDTLS_ECDSA_DETERMINISTIC

/* — X.509, CRL, CSR, certificate writing, PSS support — */
#undef MBEDTLS_X509_USE_C
#undef MBEDTLS_X509_CRT_PARSE_C
#undef MBEDTLS_X509_CRL_PARSE_C
#undef MBEDTLS_X509_CSR_PARSE_C
#undef MBEDTLS_X509_CREATE_C
#undef MBEDTLS_X509_CRT_WRITE_C
#undef MBEDTLS_X509_CSR_WRITE_C
#undef MBEDTLS_X509_RSASSA_PSS_SUPPORT
#undef MBEDTLS_X509_CHECK_KEY_USAGE
#undef MBEDTLS_X509_CHECK_EXTENDED_KEY_USAGE
#undef MBEDTLS_X509_ALLOW_EXTENSIONS_NON_V3
#undef MBEDTLS_X509_ALLOW_UNSUPPORTED_CRITICAL_EXTENSION

/* — SSL / DTLS / TLS protocol layers — */
#undef MBEDTLS_SSL_TLS_C
#undef MBEDTLS_SSL_CLI_C
#undef MBEDTLS_SSL_SRV_C
#undef MBEDTLS_SSL_TICKET_C
#undef MBEDTLS_SSL_CONTEXT_SERIALIZATION
#undef MBEDTLS_SSL_PROTO_SSL3
#undef MBEDTLS_SSL_PROTO_TLS1
#undef MBEDTLS_SSL_PROTO_TLS1_1
#undef MBEDTLS_SSL_PROTO_TLS1_2
#undef MBEDTLS_SSL_PROTO_DTLS
#undef MBEDTLS_SSL_DTLS_ANTI_REPLAY
#undef MBEDTLS_SSL_DTLS_BADMAC_LIMIT
#undef MBEDTLS_SSL_DTLS_CLIENT_PORT_REUSE

/* — DTLS/TLS settings you don’t need — */
#undef MBEDTLS_SSL_DTLS_HELLO_VERIFY
#undef MBEDTLS_SSL_ENCRYPT_THEN_MAC
#undef MBEDTLS_SSL_EXTENDED_MASTER_SECRET
#undef MBEDTLS_SSL_CBC_RECORD_SPLITTING
#undef MBEDTLS_SSL_SERVER_NAME_INDICATION

/* — PEM writing (we only need parsing) — */
#undef MBEDTLS_PEM_WRITE_C

/* — Other large modules you won’t use — */
#undef MBEDTLS_CIPHER_C
#undef MBEDTLS_AES_C
#undef MBEDTLS_ARC4_C
#undef MBEDTLS_ARIA_C
#undef MBEDTLS_BLOWFISH_C
#undef MBEDTLS_CAMELLIA_C
#undef MBEDTLS_CCM_C
#undef MBEDTLS_CHACHA20_C
#undef MBEDTLS_CHACHAPOLY_C
#undef MBEDTLS_DES_C
#undef MBEDTLS_DHM_C
#undef MBEDTLS_ECJPAKE_C
#undef MBEDTLS_ECDH_C       /* we only verify, not do full ECDH—keep ECP_C though */
#undef MBEDTLS_ENTROPY_C
#undef MBEDTLS_GCM_C
#undef MBEDTLS_HAVEGE_C
#undef MBEDTLS_HKDF_C
#undef MBEDTLS_PADLOCK_C
#undef MBEDTLS_POLY1305_C
#undef MBEDTLS_RSA_C
#undef MBEDTLS_SHA1_C
#undef MBEDTLS_SHA512_C
#undef MBEDTLS_THREADING_C
#undef MBEDTLS_ZLIB_SUPPORT
#undef MBEDTLS_NET_C
#undef MBEDTLS_FS_IO
#undef MBEDTLS_SELF_TEST

/* — Certificate bundle you don’t need — */
#undef MBEDTLS_CERTS_C

/* — PSA layers you don’t need — */
#undef MBEDTLS_PSA_CRYPTO_C
#undef MBEDTLS_PSA_ITS_FILE_C
#undef MBEDTLS_PSA_CRYPTO_C
#undef MBEDTLS_PSA_ITS_FILE_C
#undef MBEDTLS_PSA_CRYPTO_STORAGE_C    /* we don’t use PSA persistent storage */

/*============================================================================*/
/*     2) Re-enable *only* the handful you actually need for SHA-256 + ECDSA    */
/*============================================================================*/

/* bignum & ecp (curve) support */
#define MBEDTLS_BIGNUM_C
#define MBEDTLS_ECP_C
/* we only verify, never sign — so pull in no RNG: */
#define MBEDTLS_ECP_NO_INTERNAL_RNG
#define MBEDTLS_ECP_DP_SECP256R1_ENABLED

/* hashing */
#define MBEDTLS_SHA256_C
#define MBEDTLS_SHA256_SMALLER

/* minimal parsing to load a PEM public key */
#define MBEDTLS_ASN1_PARSE_C
#define MBEDTLS_BASE64_C
#define MBEDTLS_PEM_PARSE_C

/* public-key layer + parsing + ECDSA verify */
#define MBEDTLS_PK_C
#define MBEDTLS_PK_PARSE_C
#define MBEDTLS_ECDSA_C

/* bring back the generic cipher abstraction so oid.h finds mbedtls_cipher_type_t */
#define MBEDTLS_CIPHER_C

/* bring back the OID module so error.c / oid.h compile cleanly */
#define MBEDTLS_OID_C

/* Force Mbed TLS to call our own zeroizer instead of the
   built-in indirect memset_func version: */
#define MBEDTLS_PLATFORM_ZEROIZE_ALT

/* Tell Mbed-TLS to pull in its platform layer: */
#define MBEDTLS_PLATFORM_C

/* Turn on the “memory buffer” allocator: */
#define MBEDTLS_MEMORY_BUFFER_ALLOC_C

/* Turn on the platform memory abstraction so that
 * platform_std_calloc/free get used instead of raw malloc/free */
#define MBEDTLS_PLATFORM_MEMORY

/* Give it something sensible to call: */
#define MBEDTLS_PLATFORM_STD_CALLOC    calloc
#define MBEDTLS_PLATFORM_STD_FREE      free

#endif /* MBEDTLS_USER_CONFIG_H */
